# Build artefacts - regenerated by ./sim/run_all.sh in about a second,
# so there is no reason to version them.
build/

# Simulation binaries and intermediate files
*.out
*.vvp

# LaTeX intermediates (the built PDF IS committed - it is a deliverable)
docs/ieee_report/*.aux
docs/ieee_report/*.log
docs/ieee_report/*.out
docs/ieee_report/*.bbl
docs/ieee_report/*.blg
docs/ieee_report/*.synctex.gz

# Vivado run outputs (large; the extracted fpga.csv is what matters)
results/vivado/*.dcp
results/vivado/*.jou
results/vivado/*.log
vivado*.jou
vivado*.log
.Xil/

# macOS
.DS_Store

#==========================================================================
# run_vivado.tcl - one-command FPGA characterisation of all four
#                  configurations
#
# Owner: Member E (infrastructure)
#
# Runs synthesis AND implementation (place and route) for each of the four
# configurations, then writes results/vivado/fpga.csv with the numbers the
# report needs: LUTs, flip-flops, distributed RAM, block RAM, carry cells,
# and worst negative slack.
#
# Usage, from the PROJECT ROOT:
#
#   vivado -mode batch -source fpga/run_vivado.tcl
#   vivado -mode batch -source fpga/run_vivado.tcl -tclargs xc7a35tcpg236-1 10.0 vecsum64
#
#   tclargs, all optional and positional:
#     1  part        default xc7a35tcpg236-1   (Artix-7, the Basys 3 part)
#     2  period_ns   default 10.0              (100 MHz target)
#     3  program     default vecsum64          (which hex image to load)
#
# No bitstream is generated: there is no board requirement and no pinout
# is invented.  Place and route still run, so the timing numbers are
# post-route and therefore real rather than optimistic post-synthesis
# estimates.
#
#--------------------------------------------------------------------------
# Timing methodology
#--------------------------------------------------------------------------
# The question being asked is "how fast can each configuration's internal
# logic run", so the I/O paths must be excluded.  With a clock defined and
# no output delay specified, Vivado would time every observation output
# against the clock with zero budget, and those paths - which exist only
# so the testbench can watch the core and would not be pins on a real
# chip - could easily become the reported critical path and corrupt the
# comparison.
#
# So the constraints false-path all outputs and the reset input, leaving
# register-to-register paths inside the core as the only timed paths.
# That is exactly what should be compared between configurations.
#
#--------------------------------------------------------------------------
# How the numbers are extracted
#--------------------------------------------------------------------------
# By querying the in-memory design with get_cells / get_timing_paths
# rather than by text-scraping report files.  Report formatting changes
# between Vivado versions; these object properties do not.  The full
# reports are written out as well, so anything surprising can be checked
# by hand.
#==========================================================================

set part   "xc7a35tcpg236-1"
set period 10.0
set prog   "vecsum64"

if {[llength $argv] >= 1} { set part   [lindex $argv 0] }
if {[llength $argv] >= 2} { set period [lindex $argv 1] }
if {[llength $argv] >= 3} { set prog   [lindex $argv 2] }

# Project root, derived from this script's location, so the script works
# regardless of the directory Vivado was launched from.
set here [file dirname [file normalize [info script]]]
set root [file dirname $here]

set rundir [file join $root results vivado]
file mkdir $rundir

#--------------------------------------------------------------------------
# Memory images.  Copied into the run directory under the bare names the
# wrappers expect, so $readmemh resolves with no absolute paths in the
# RTL.  See fpga/wrappers/cfg_wrappers.v.
#--------------------------------------------------------------------------
set imem [file join $root programs "$prog.imem.hex"]
set dmem [file join $root programs "$prog.dmem.hex"]

if {![file exists $imem]} {
    puts "ERROR: $imem not found. Run ./sim/run_all.sh first to assemble the programs."
    exit 1
}

cd $rundir
file copy -force $imem "imem_init.hex"
if {[file exists $dmem] && [file size $dmem] > 0} {
    file copy -force $dmem "dmem_init.hex"
} else {
    # Some programs have no .data section; give the data memory an empty
    # but existing image so $readmemh does not error.
    set fh [open "dmem_init.hex" w]
    puts $fh "00000000"
    close $fh
}

#--------------------------------------------------------------------------
# Constraints
#--------------------------------------------------------------------------
set xdc [open "timing.xdc" w]
puts $xdc "# generated by fpga/run_vivado.tcl - do not edit"
puts $xdc "create_clock -period $period -name clk \[get_ports clk\]"
puts $xdc "# Exclude I/O from timing: see the methodology note in run_vivado.tcl"
puts $xdc "set_false_path -from \[get_ports rst\]"
puts $xdc "set_false_path -to \[all_outputs\]"
close $xdc

#--------------------------------------------------------------------------
# Source files
#--------------------------------------------------------------------------
set srcs [list]
foreach f [glob [file join $root rtl common *.v]]      { lappend srcs $f }
foreach f [glob [file join $root rtl single_cycle *.v]] { lappend srcs $f }
foreach f [glob [file join $root rtl pipelined *.v]]    { lappend srcs $f }
lappend srcs [file join $root fpga wrappers cfg_wrappers.v]

set incdir [file join $root rtl common]

#--------------------------------------------------------------------------
# Per-configuration run
#--------------------------------------------------------------------------
set csv [open "fpga.csv" w]
puts $csv "config,luts,ffs,lutram,bram,carry,period_ns,wns_ns,achieved_ns,fmax_mhz"

set configs [list \
    [list single "Single-cycle"] \
    [list stall  "Pipelined (stall only)"] \
    [list fwd    "Pipelined (forwarding)"] \
    [list pred   "Pipelined (fwd + 2-bit predictor)"] ]

foreach cfgpair $configs {
    set cfg   [lindex $cfgpair 0]
    set label [lindex $cfgpair 1]
    set top   "cfg_$cfg"

    puts ""
    puts "########################################################"
    puts "# $label   (top = $top, part = $part, target = $period ns)"
    puts "########################################################"

    # ---- synthesis ----
    read_verilog -verilog $srcs
    read_xdc "timing.xdc"
    synth_design -top $top -part $part -include_dirs $incdir
    report_utilization -file "${cfg}_util_synth.rpt"
    write_checkpoint -force "${cfg}_synth.dcp"

    # ---- implementation ----
    opt_design
    place_design
    phys_opt_design
    route_design

    report_utilization      -file "${cfg}_util_impl.rpt"
    report_timing_summary   -file "${cfg}_timing.rpt"
    report_timing -max_paths 10 -file "${cfg}_timing_paths.rpt"
    write_checkpoint -force "${cfg}_impl.dcp"

    # ---- extract, by querying the design rather than scraping text ----
    set luts   [llength [get_cells -quiet -hier -filter {PRIMITIVE_GROUP == LUT}]]
    set ffs    [llength [get_cells -quiet -hier -filter {PRIMITIVE_GROUP == FLOP_LATCH}]]
    set lutram [llength [get_cells -quiet -hier -filter {PRIMITIVE_SUBGROUP == LUTRAM}]]
    set bram   [llength [get_cells -quiet -hier -filter {PRIMITIVE_GROUP == BLOCKRAM}]]
    set carry  [llength [get_cells -quiet -hier -filter {PRIMITIVE_GROUP == CARRY}]]

    # Worst setup slack across the whole design.
    set wns "NA"
    set paths [get_timing_paths -quiet -delay_type max -max_paths 1]
    if {[llength $paths] > 0} {
        set wns [get_property SLACK [lindex $paths 0]]
    }

    set achieved "NA"
    set fmax     "NA"
    if {$wns ne "NA" && $wns ne ""} {
        set achieved [expr {$period - $wns}]
        if {$achieved > 0} {
            set fmax [format "%.1f" [expr {1000.0 / $achieved}]]
        }
        set achieved [format "%.3f" $achieved]
    }

    puts ""
    puts ">>> $label"
    puts ">>>   LUTs=$luts  FFs=$ffs  LUTRAM=$lutram  BRAM=$bram  CARRY=$carry"
    puts ">>>   target=${period}ns  WNS=${wns}ns  achieved=${achieved}ns  Fmax=${fmax}MHz"

    puts $csv "$cfg,$luts,$ffs,$lutram,$bram,$carry,$period,$wns,$achieved,$fmax"
    flush $csv

    close_design
}

close $csv

puts ""
puts "########################################################"
puts "# Done. Wrote [file join $rundir fpga.csv]"
puts "# Per-configuration reports are in $rundir"
puts "#"
puts "# Now generate the report table:"
puts "#   python3 tools/fpga_table.py"
puts "#"
puts "# If any WNS is NEGATIVE the design missed the ${period} ns target."
puts "# Re-run with a longer period, e.g.:"
puts "#   vivado -mode batch -source fpga/run_vivado.tcl -tclargs $part 15.0 $prog"
puts "########################################################"
